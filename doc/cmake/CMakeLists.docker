# Docker 预加载配置。进入容器后在项目根目录运行：
# cmake -S . -B build/docker -C doc/cmake/CMakeLists.docker
# 根 CMake 会将 src 核心与 workspace/export C ABI/CPM 一起编译，动态库输出为
# workspace/export/libyolo26.so。

# Dockerfile 将 CUDA 和 TensorRT 安装到标准位置，仍可用 -D 参数覆盖。
set(CUDAToolkit_ROOT "/usr/local/cuda" CACHE PATH "CUDA 安装目录")
set(CMAKE_CUDA_COMPILER "/usr/local/cuda/bin/nvcc" CACHE FILEPATH
    "CUDA 编译器")
set(TENSORRT_ROOT "/usr" CACHE PATH "TensorRT 10 安装目录")
set(CMAKE_CUDA_ARCHITECTURES "75;86;89;90" CACHE STRING
    "需要生成 CUDA 代码的 GPU 架构")
set(YOLO26_EXPORT_SOURCE_DIR
    "${CMAKE_CURRENT_LIST_DIR}/../../workspace/export" CACHE PATH
    "C ABI 与 CPM 导出实现目录")

# OpenCV 只供 workspace/example 使用，不会链接到 yolo26 动态库。
set(YOLO26_BUILD_EXAMPLE ON CACHE BOOL "构建由 config.h 驱动的 OpenCV 示例")
