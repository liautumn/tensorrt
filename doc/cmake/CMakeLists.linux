# Linux 预加载配置。用法：
# cmake -S . -B build/linux -C doc/cmake/CMakeLists.linux \
#   -DTENSORRT_ROOT=/opt/TensorRT-10.13.3.9
# 根 CMake 会将 src 核心与 workspace/export C ABI/CPM 一起编译，动态库输出为
# workspace/export/libyolo26.so。

# 可通过命令行覆盖 GPU 架构，例如 -DCMAKE_CUDA_ARCHITECTURES=86。
set(CMAKE_CUDA_ARCHITECTURES "75;86;89;90" CACHE STRING
    "需要生成 CUDA 代码的 GPU 架构")
set(YOLO26_EXPORT_SOURCE_DIR
    "${CMAKE_CURRENT_LIST_DIR}/../../workspace/export" CACHE PATH
    "C ABI 与 CPM 导出实现目录")

# 优先读取环境变量，同时允许后续使用 -D 参数覆盖。
if(DEFINED ENV{CUDA_PATH})
  set(CUDAToolkit_ROOT "$ENV{CUDA_PATH}" CACHE PATH "CUDA 安装目录")
  if(EXISTS "$ENV{CUDA_PATH}/bin/nvcc")
    set(CMAKE_CUDA_COMPILER "$ENV{CUDA_PATH}/bin/nvcc" CACHE FILEPATH
        "CUDA 编译器")
  endif()
endif()
if(DEFINED ENV{TENSORRT_ROOT})
  set(TENSORRT_ROOT "$ENV{TENSORRT_ROOT}" CACHE PATH "TensorRT 10 安装目录")
elseif(DEFINED ENV{TENSORRT_PATH})
  set(TENSORRT_ROOT "$ENV{TENSORRT_PATH}" CACHE PATH "TensorRT 10 安装目录")
endif()

# 示例默认开启；只构建动态库时传入 -DYOLO26_BUILD_EXAMPLE=OFF。
set(YOLO26_BUILD_EXAMPLE ON CACHE BOOL "构建由 config.h 驱动的 OpenCV 示例")
