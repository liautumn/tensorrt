# Windows 预加载配置。请在 Visual Studio x64 开发者终端中运行：
# cmake -S . -B build/win -C doc/cmake/CmakeLists.win \
#   -DTENSORRT_ROOT=C:/TensorRT-10.13.3.9 -DOpenCV_DIR=C:/opencv/build
# 根 CMake 会将 src 核心与 workspace/export C ABI/CPM 一起编译，动态库和导入库输出为
# workspace/export/yolo26.dll 与 workspace/export/yolo26.lib。

# 可按显卡修改该值，例如只为 RTX 30 系列设置 86。
set(CMAKE_CUDA_ARCHITECTURES "75;86;89;90" CACHE STRING
    "需要生成 CUDA 代码的 GPU 架构")
set(YOLO26_EXPORT_SOURCE_DIR
    "${CMAKE_CURRENT_LIST_DIR}/../../workspace/export" CACHE PATH
    "C ABI 与 CPM 导出实现目录")

# 兼容 NVIDIA、TensorRT 和 OpenCV 常用的 Windows 环境变量。
if(DEFINED ENV{CUDA_PATH})
  file(TO_CMAKE_PATH "$ENV{CUDA_PATH}" _cuda_path)
  set(CUDAToolkit_ROOT "${_cuda_path}" CACHE PATH "CUDA 安装目录")
  if(EXISTS "${_cuda_path}/bin/nvcc.exe")
    set(CMAKE_CUDA_COMPILER "${_cuda_path}/bin/nvcc.exe" CACHE FILEPATH
        "CUDA 编译器")
  endif()
endif()
if(DEFINED ENV{TENSORRT_PATH})
  file(TO_CMAKE_PATH "$ENV{TENSORRT_PATH}" _tensorrt_path)
  set(TENSORRT_ROOT "${_tensorrt_path}" CACHE PATH "TensorRT 10 安装目录")
endif()
if(DEFINED ENV{OPENCV_PATH})
  file(TO_CMAKE_PATH "$ENV{OPENCV_PATH}" _opencv_path)
  set(OpenCV_DIR "${_opencv_path}" CACHE PATH "OpenCV CMake 配置目录")
endif()

# yolo26.dll 和配置驱动示例默认同时生成。
set(YOLO26_BUILD_EXAMPLE ON CACHE BOOL "构建由 config.h 驱动的 OpenCV 示例")
